<Layouts.app flash={@flash}>
  <section
    class="flex items-end justify-between gap-8 py-10 lg:py-12"
    aria-labelledby="page-title"
  >
    <div>
      <p class="m-0 flex items-center gap-3 text-xs font-bold uppercase tracking-[.15em] text-[#42586b]">
        <span class="size-2 shrink-0 rounded-full bg-[#ff835d] shadow-[0_0_0_4px_#ff835d21]">
        </span>
        Flight dynamics / mission planner
      </p>
      <h1
        id="page-title"
        class="my-4 text-[clamp(3.25rem,6.3vw,6.9rem)] leading-[.94] font-[760] tracking-[-.085em]"
      >
        Every journey<br />has a weight.
      </h1>
      <p class="m-0 max-w-lg text-base leading-relaxed text-[#536472]">
        Plot each launch and landing. See the fuel your spacecraft needs to carry the whole journey.
      </p>
    </div>
    <div
      class="hidden w-[220px] shrink-0 flex-col items-end gap-2 border-t border-[#9cabb5] pt-3 text-xs tracking-wide text-[#637280] sm:flex"
      aria-hidden="true"
    >
      <span class="font-extrabold text-[#152237]">01 / 02</span>
      <span class="whitespace-nowrap">Earth &nbsp;→&nbsp; Moon &nbsp;→&nbsp; Mars</span>
    </div>
  </section>

  <section
    class="grid min-h-[700px] grid-cols-1 border border-[#c9d4dc] bg-white shadow-[0_22px_60px_-45px_#192a3f59] lg:grid-cols-[minmax(0,1fr)_minmax(370px,.78fr)]"
    aria-label="Mission calculator"
  >
    <div class="min-w-0 px-5 pt-7 pb-8 sm:px-8 lg:px-11 lg:pt-9 lg:pb-12">
      <.form for={@form} id="mission-form" phx-change="validate">
        <section class="border-b border-[#cdd7dd] pb-10" aria-labelledby="mass-heading">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="m-0 text-xs font-bold uppercase tracking-[.15em] text-[#b84e39]">
                01 <span class="text-[#6b7784]">/ spacecraft</span>
              </p>
              <h2
                id="mass-heading"
                class="mt-2.5 mb-0 text-[1.6rem] leading-tight font-bold tracking-[-.055em] max-sm:text-[1.35rem]"
              >
                Start with your mass
              </h2>
            </div>
            <p class="m-0 max-w-52 text-right text-xs leading-snug text-[#5e6c79] max-sm:max-w-28">
              Payload and equipment before fuel.
            </p>
          </div>
          <div class="relative max-w-[22rem] [&>div]:mb-0">
            <.input
              field={@form[:mass]}
              id="spacecraft-mass"
              type="number"
              min="1"
              step="1"
              label="Spacecraft mass"
              class="block h-[4.4rem] w-full rounded-sm border border-[#aebcc6] bg-[#f8fafb] py-1 pr-16 pl-4 text-[2.1rem] font-bold tracking-[-.06em] text-[#152237] outline-none transition focus:border-[#317488] focus:ring-3 focus:ring-[#53adbe33]"
              error_class="border-[#bb4b41]"
            />
            <span
              class="pointer-events-none absolute top-[2.75rem] right-4 text-sm text-[#687887]"
              aria-hidden="true"
            >
              kg
            </span>
          </div>
        </section>

        <section class="pt-10" aria-labelledby="path-heading">
          <div class="mb-6 flex items-end justify-between gap-4 max-sm:items-start">
            <div>
              <p class="m-0 text-xs font-bold uppercase tracking-[.15em] text-[#b84e39]">
                02 <span class="text-[#6b7784]">/ trajectory</span>
              </p>
              <h2
                id="path-heading"
                class="mt-2.5 mb-0 text-[1.6rem] leading-tight font-bold tracking-[-.055em] max-sm:text-[1.35rem]"
              >
                Build the flight path
              </h2>
            </div>
            <p
              id="step-count"
              class="m-0 max-w-52 text-right text-xs leading-snug text-[#5e6c79] max-sm:max-w-28"
            >
              {@step_count} {if @step_count == 1, do: "maneuver", else: "maneuvers"} in sequence
            </p>
          </div>

          <div id="flight-steps" class="pl-0.5">
            <.inputs_for :let={step_form} field={@form[:steps]}>
              <div
                id={"flight-step-#{step_form.index}"}
                class={[
                  "relative grid grid-cols-[2rem_minmax(0,1fr)_1.8rem] gap-2 sm:grid-cols-[2.7rem_minmax(0,1fr)_2.25rem] sm:gap-4",
                  step_form.index > 0 && "pt-5"
                ]}
              >
                <div class="relative flex justify-center pt-7 sm:pt-[1.625rem]" aria-hidden="true">
                  <span
                    :if={step_form.index < @step_count - 1}
                    class="absolute top-[3.75rem] bottom-[-2.875rem] left-1/2 w-px -translate-x-1/2 bg-[#b8c8d1]"
                  >
                  </span>
                  <span class="relative z-10 grid size-[1.8rem] place-items-center rounded-full bg-[#152237] text-[.65rem] font-extrabold text-white sm:size-8">
                    {String.pad_leading(Integer.to_string(step_form.index + 1), 2, "0")}
                  </span>
                </div>
                <div class="grid grid-cols-2 gap-2 border-b border-[#e0e7eb] pb-5 sm:gap-3 [&>div]:mb-0">
                  <.mission_select
                    field={step_form[:action]}
                    id={"step-action-#{step_form.index}"}
                    label="Maneuver"
                    options={[Launch: :launch, Land: :land]}
                  />
                  <.mission_select
                    field={step_form[:planet]}
                    id={"step-planet-#{step_form.index}"}
                    label="At"
                    options={[Earth: :earth, Moon: :moon, Mars: :mars]}
                  />
                </div>
                <button
                  id={"remove-step-#{step_form.index}"}
                  type="button"
                  phx-click="remove_step"
                  phx-value-index={step_form.index}
                  aria-label={"Remove step #{step_form.index + 1}"}
                  class="mt-5 grid h-11 w-full place-items-center text-[#8795a1] transition hover:bg-[#fff0eb] hover:text-[#a93b2c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b9aad]"
                >
                  <.icon name="hero-x-mark" class="size-5" />
                </button>
              </div>
            </.inputs_for>
            <div
              :if={@step_count == 0}
              id="empty-flight-path"
              class="py-6 pl-10 text-[#152237] sm:pl-[3.65rem]"
            >
              <p class="mb-1 font-bold">No maneuvers plotted.</p>
              <span class="text-sm text-[#5e6c79]">
                Add a launch or landing to calculate the trip.
              </span>
            </div>
          </div>
          <button
            id="add-step"
            type="button"
            phx-click="add_step"
            class="mt-6 ml-10 inline-flex items-center gap-3 text-sm font-bold text-[#154f64] transition hover:text-[#b84e39] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3b9aad] sm:ml-[3.7rem]"
          >
            <span class="grid size-8 place-items-center rounded-full border border-current">
              <.icon name="hero-plus" class="size-4" />
            </span>
            Add maneuver
          </button>
        </section>
      </.form>
    </div>

    <aside
      class="flex min-w-0 flex-col overflow-hidden bg-[#101b2d] text-[#e9f0f3] md:grid md:grid-cols-2 lg:flex"
      aria-labelledby="result-heading"
    >
      <div
        class="relative h-[270px] overflow-hidden md:row-span-2 md:h-auto md:min-h-[330px] lg:h-[350px] lg:min-h-0"
        aria-hidden="true"
      >
        <svg
          class="absolute inset-0 size-full"
          viewBox="0 0 600 350"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            <radialGradient id="plot-background">
              <stop offset="0%" stop-color="#233d54" />
              <stop offset="50%" stop-color="#172940" />
              <stop offset="100%" stop-color="#101b2d" />
            </radialGradient>
            <radialGradient id="earth-color" cx="30%" cy="30%">
              <stop offset="0%" stop-color="#c1f9e6" />
              <stop offset="50%" stop-color="#6fb6ce" />
              <stop offset="100%" stop-color="#2a6c89" />
            </radialGradient>
            <radialGradient id="mars-color" cx="30%" cy="30%">
              <stop offset="0%" stop-color="#ffab7f" />
              <stop offset="100%" stop-color="#c66052" />
            </radialGradient>
            <pattern id="plot-grid" width="38" height="38" patternUnits="userSpaceOnUse">
              <path d="M 38 0 L 0 0 0 38" fill="none" stroke="#6b96a6" stroke-opacity=".14" />
            </pattern>
          </defs>
          <rect width="600" height="350" fill="url(#plot-background)" />
          <rect width="600" height="350" fill="url(#plot-grid)" />
          <g transform="rotate(-22 312 190)" fill="none" stroke="#adcfd9">
            <ellipse cx="312" cy="190" rx="277" ry="147" stroke-opacity=".18" />
            <ellipse cx="312" cy="190" rx="168" ry="93" stroke-opacity=".27" />
            <ellipse cx="312" cy="190" rx="85" ry="44" stroke-opacity=".27" />
          </g>
          <circle cx="312" cy="190" r="24" fill="#ffb66a" opacity=".12" />
          <circle cx="312" cy="190" r="15" fill="#ffb66a" />
          <circle cx="120" cy="105" r="12" fill="url(#earth-color)" />
          <circle cx="390" cy="245" r="5.5" fill="#d8d5c3" />
          <circle cx="505" cy="72" r="8.5" fill="url(#mars-color)" />
          <g fill="#bbd1dc" font-size="10" font-weight="700" letter-spacing="1.2">
            <text x="140" y="109">EARTH</text>
            <text x="403" y="249">MOON</text>
            <text x="520" y="76">MARS</text>
          </g>
        </svg>
        <span class="absolute top-6 left-7 font-mono text-[.58rem] tracking-wider text-[#829bac]">
          ORBITAL REFERENCE / NOT TO SCALE
        </span>
        <span class="absolute right-7 bottom-6 font-mono text-[.58rem] tracking-wider text-[#829bac]">
          EARTH / MOON / MARS
        </span>
      </div>

      <div
        id="fuel-result"
        class="border-t border-[#425b70] px-6 pt-8 pb-9 md:border-t-0 lg:border-t lg:px-10"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="m-0 text-xs font-bold uppercase tracking-[.15em] text-[#9fe5ed]">
              Calculated fuel mass
            </p>
            <h2 id="result-heading" class="mt-2 mb-0 text-xl font-semibold tracking-[-.03em]">
              Required for this route
            </h2>
          </div>
          <span class="inline-flex items-center gap-2 whitespace-nowrap text-xs text-[#b4c6cf]">
            <span class="size-1.5 rounded-full bg-[#ff835d] shadow-[0_0_0_4px_#ff835d21]"></span>
            Live estimate
          </span>
        </div>
        <div
          :if={@total != nil}
          id="fuel-total"
          class="my-7 flex items-baseline gap-3 whitespace-nowrap"
          aria-live="polite"
        >
          <span class="text-[clamp(3.35rem,5.8vw,6.4rem)] leading-none font-[760] tracking-[-.085em] tabular-nums">
            {format_number(@total)}
          </span>
          <span class="text-xl font-semibold text-[#9fe5ed]">kg</span>
        </div>
        <div :if={@total == nil} id="fuel-prompt" class="my-8" aria-live="polite">
          <strong class="block text-2xl tracking-tight">Awaiting a valid route</strong>
          <p class="text-sm text-[#b4c6cf]">Enter a positive mass and at least one maneuver.</p>
        </div>
        <div class="flex items-start gap-4 border-t border-[#3a4e60] pt-5">
          <span class="mt-2 h-0.5 w-7 shrink-0 bg-[#ff835d]"></span>
          <p class="m-0 max-w-sm text-xs leading-relaxed text-[#a9bcc9]">
            Fuel for later maneuvers adds weight to every earlier one. The estimate includes that carried fuel.
          </p>
        </div>
      </div>

      <div class="mt-auto border-t border-[#3a4e60] px-6 pt-5 pb-7 lg:px-10">
        <p class="mb-4 flex justify-between text-xs font-bold text-[#bbccd5]">
          Reference gravity <span class="font-normal text-[#91a7b6]">m/s²</span>
        </p>
        <dl class="m-0 grid grid-cols-3">
          <div class="pr-2">
            <dt class="text-xs text-[#9fb3c1]">Earth</dt>
            <dd class="mt-1 ml-0 text-lg font-bold tabular-nums">9.807</dd>
          </div>
          <div class="border-l border-[#3d5060] px-3">
            <dt class="text-xs text-[#9fb3c1]">Moon</dt>
            <dd class="mt-1 ml-0 text-lg font-bold tabular-nums">1.620</dd>
          </div>
          <div class="border-l border-[#3d5060] pl-3">
            <dt class="text-xs text-[#9fb3c1]">Mars</dt>
            <dd class="mt-1 ml-0 text-lg font-bold tabular-nums">3.711</dd>
          </div>
        </dl>
        <small class="mt-6 block text-[.67rem] text-[#8197a8]">
          Fuel is rounded down to whole kilograms at each calculation.
        </small>
      </div>
    </aside>
  </section>
</Layouts.app>
